{
  "name": "trama.website",
  "version": "0.0.1",
  "description": "Um novo espaço para a produção editorial. Produto em desenvolvimento.",
  "main": "index.js",
  "scripts": {
    "build": "next build",
    "start": "next start --port 3001",
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && (trap 'npm run services:stop' INT TERM ; next dev --port 3001)",
    "test": "node infra/scripts/run-tests.js",
    "test:watch": "node infra/scripts/run-tests.js --watch",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development down",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@vercel/functions": "3.10.1",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "docx": "9.12.0",
    "dotenv": "18.0.5",
    "dotenv-expand": "1000.0.0",
    "next": "16.3.8",
    "next-connect": "1.0.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.1.7",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.3",
    "resend": "6.34.1",
    "swr": "2.5.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@faker-js/faker": "10.6.0",
    "commitizen": "4.3.2",
    "concurrently": "10.0.5",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "prettier": "3.9.9"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
